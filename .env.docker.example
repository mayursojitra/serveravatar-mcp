# Settings for docker-compose.yml. Copy this file to .env (next to docker-compose.yml) and fill it in.
# This is Compose's own file: it is not the Laravel .env, and it is never copied into the image.

# CHANGE: the address people open, with https. The app answers only to this host (and TRUSTED_HOSTS).
APP_URL=https://mcp.example.com

# CHANGE: generate once, before the first `docker compose` command (even the build needs it), with
#   echo "APP_KEY=base64:$(openssl rand -base64 32)"
# and paste the whole line here. Back it up: without it the saved ServerAvatar tokens cannot be read.
APP_KEY=

# CHANGE: a long random password for the bundled database.
DB_PASSWORD=

# The IP address(es) of your reverse proxy, comma-separated, or empty if none. Use "*" only if the
# container's port is reachable solely through your own proxy.
TRUSTED_PROXIES=

# Extra hostnames the app may be opened at, comma-separated. Usually empty.
TRUSTED_HOSTS=

# Content-Security-Policy for pages: enforce (default), report-only, or off.
# CSP_MODE=enforce

# Host port for the app (the container listens on 8080).
APP_PORT=8080

# Run the published image instead of building it from source. Pin a version: every start of a new
# version migrates the database, so "latest" can upgrade you without you asking. Leave it commented
# out to build from the checked-out source (`docker compose up -d --build`).
# SERVERAVATAR_IMAGE=ghcr.io/mayursojitra/serveravatar-mcp:1.0

# Password-reset e-mails. "log" writes them to the log instead of sending; use smtp for real mail.
MAIL_MAILER=log
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS=no-reply@example.com
