APP_NAME="ServerAvatar MCP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12
# Passwords are hashed with argon2id (see config/hashing.php)

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=serveravatar_mcp
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
# Behind HTTPS in production, set this to true so the session cookie is never sent over plain HTTP.
# SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Comma-separated proxy IPs/CIDRs to trust for X-Forwarded-For (empty = trust none).
# Use "*" only if the app is reachable exclusively through your own reverse proxy.
TRUSTED_PROXIES=

# The app answers only to the host in APP_URL (plus localhost). If it is reachable under more
# hostnames, list the extra ones here, comma-separated, hostnames only.
TRUSTED_HOSTS=

# Content-Security-Policy for pages: enforce (default), report-only, or off.
CSP_MODE=enforce

# true makes every user set up two-factor sign-in (an authenticator app) before they can use anything else.
REQUIRE_TWO_FACTOR=false

# Activity log rows older than this many days are pruned daily.
ACTIVITY_LOG_RETENTION_DAYS=90

# --- AI client connections (OAuth 2.1 + MCP) ---------------------------------------------------
# Passport signs access tokens with keys in storage/ (create them once with `php artisan passport:keys`;
# never commit them). In Docker you can pass the keys here instead, with \n for line breaks.
# PASSPORT_PRIVATE_KEY=
# PASSPORT_PUBLIC_KEY=

# Access tokens are short; clients renew them silently with the refresh token.
OAUTH_ACCESS_TOKEN_MINUTES=60
OAUTH_REFRESH_TOKEN_DAYS=30

# Where an AI client may be sent back to after the user approves (comma-separated scheme + host).
# Never use "*". Add your own client's address here if it is not listed.
MCP_REDIRECT_DOMAINS=https://claude.ai,https://claude.com,http://localhost,http://127.0.0.1
# Private-use schemes of desktop clients (RFC 8252).
MCP_CUSTOM_SCHEMES=cursor,vscode
# Extra browser origins allowed to call /mcp (the app's own URL and localhost always are).
MCP_ALLOWED_ORIGINS=

# Requests per minute: per user on /mcp, and per IP for open client registration.
MCP_RATE_LIMIT=120
OAUTH_REGISTER_RATE_LIMIT=20

# --- ServerAvatar API ---------------------------------------------------------------------------
# Each user saves their own API token in the app; these are the shared settings for calling the API.
SERVERAVATAR_API_URL=https://api.serveravatar.com
SERVERAVATAR_CONNECT_TIMEOUT=5
SERVERAVATAR_TIMEOUT=20
# Creating an application can take longer than the usual timeout (Statamic took more than 20 seconds).
SERVERAVATAR_SLOW_TIMEOUT=120
SERVERAVATAR_MAX_RETRIES=2
# Saves and tests on the token page per minute, per user.
TOKEN_WRITE_RATE_LIMIT=10

